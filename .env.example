# Set this on the web server only. Never put the API key in browser code.
GEMINI_API_KEY=replace-with-your-server-side-key
GEMINI_MODEL=gemini-3.8-flash
PORT=4174

# Optional social feed: connect your Facebook Page to a professional Instagram account.
META_GRAPH_API_VERSION=v26.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Optional: otherwise the linked Instagram business account is read from the Page.
META_IG_USER_ID=
